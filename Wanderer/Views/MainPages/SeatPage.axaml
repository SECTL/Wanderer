<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Wanderer.Views.MainPages"
             xmlns:vm="using:Wanderer.ViewModels.MainPages"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:controls="clr-namespace:Wanderer.Controls"
             xmlns:pz="clr-namespace:Avalonia.Controls.PanAndZoom;assembly=PanAndZoom"
             xmlns:converters="clr-namespace:Wanderer.Converters"
             xmlns:wa="https://github.com/SECTL/Wanderer/schemas/xaml"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Wanderer.Views.MainPages.SeatPage"
             x:Name="RootControl"
             x:DataType="local:SeatPage"
             d:DataContext="{d:DesignInstance local:SeatPage}">
    <UserControl.Resources>
        <converters:HumanSexToStringConverter x:Key="HumanSexToStringConverter" />

        <DataTemplate x:Key="SeatTemplate" x:DataType="vm:SeatItemViewModel">
            <!-- 尺寸由视图模型统一算出：宽度 = (座位区可用宽度 ÷ 列数)，夹在最小宽高与最大宽/高之间，
                 所有座位共用同一个宽高，因此行列必然对齐。 -->
            <Border Margin="{Binding #RootControl.ViewModel.SeatThickness}"
                    Width="{Binding #RootControl.ViewModel.SeatItemWidth}"
                    Height="{Binding #RootControl.ViewModel.SeatItemHeight}"
                    Padding="8"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                <Panel>
                    <!-- 正常模式 -->
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="2"
                          IsVisible="{Binding !#RootControl.ViewModel.IsSetupMode}">
                        <WrapPanel Grid.Row="0" ItemSpacing="4" LineSpacing="2">
                            <TextBlock Theme="{StaticResource SubtitleTextBlockStyle}"
                                       Text="{Binding DisplayName}"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock IsVisible="{Binding HasDisplayId}"
                                       VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding DisplayId}"
                                       TextTrimming="CharacterEllipsis" />
                        </WrapPanel>

                        <controls:PersonAttendanceEditor Grid.Row="2"
                                                         VerticalAlignment="Bottom"
                                                         Row="{Binding Attendance}" />

                        <wa:FluentIcon Grid.Row="0" Grid.RowSpan="3"
                                       Glyph="{wa:Fi CircleRegular}"
                                       IsVisible="{Binding IsEmpty}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="32"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>

                    <!-- 设置模式 -->
                    <StackPanel Spacing="4" VerticalAlignment="Center"
                                IsVisible="{Binding #RootControl.ViewModel.IsSetupMode}">
                        <CheckBox Content="有人"
                                  IsChecked="{Binding IsOccupied, Mode=TwoWay}" />

                        <AutoCompleteBox x:CompileBindings="False"
                                         HorizontalAlignment="Stretch"
                                         ItemsSource="{Binding #RootControl.ViewModel.PersonChoices}"
                                         Text="{Binding OccupantText, Mode=TwoWay}"
                                         SelectedItem="{Binding Occupant, Mode=OneWay}"
                                         ValueMemberBinding="{Binding Name}"
                                         FilterMode="Custom"
                                         ItemFilter="{Binding #RootControl.ViewModel.PersonFilter}"
                                         MinimumPrefixLength="0"
                                         ClearSelectionOnLostFocus="False"
                                         MaxDropDownHeight="360"
                                         IsEnabled="{Binding IsOccupied}"
                                         PlaceholderText="选择人员">
                            <AutoCompleteBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PersonChoice">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4"
                                          VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   FontSize="14" Text="{Binding Name}" />

                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="Gray" Text="{Binding Id}" />

                                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="Gray"
                                                   Text="{Binding Sex, Converter={StaticResource HumanSexToStringConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>

                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   IsVisible="{Binding IsUnmatched}"
                                   Text="未找到该人员" />
                    </StackPanel>
                </Panel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto * Auto" Classes="animated-intro">
        <pz:ZoomBorder Grid.Row="1"
                       x:Name="SeatZoom"
                       Background="Transparent"
                       Stretch="None"
                       MinZoomX="0.25" MaxZoomX="3"
                       MinZoomY="0.25" MaxZoomY="3"
                       EnableConstrains="True"
                       BoundsMode="KeepContentVisible"
                       PanButton="Left"
                       EnableGestures="True"
                       EnableDoubleClickZoom="True"
                       EnableGestureRotation="False"
                       EnableRotationSnapping="False"
                       DoubleClickZoomMode="ZoomToFit"
                       ZoomChanged="SeatZoom_OnZoomChanged">
            <ItemsControl x:Name="SeatGrid"
                          Margin="{Binding ViewModel.GridThickness}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="{Binding ViewModel.GridWidth}"
                          MinHeight="{Binding ViewModel.GridHeight}"
                          ItemTemplate="{StaticResource SeatTemplate}"
                          ItemsSource="{Binding ViewModel.Seats}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding ViewModel.Rows}"
                                     Columns="{Binding ViewModel.Columns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </pz:ZoomBorder>
        
        <Border Grid.Row="0" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel Margin="8 4"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding ViewModel.IsSetupMode}">
                <TextBlock VerticalAlignment="Center" Text="行数" />

                <fa:FANumberBox x:CompileBindings="False"
                                MinWidth="104"
                                Minimum="1"
                                Maximum="50"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                ValidationMode="InvalidInputOverwritten"
                                Value="{Binding ViewModel.Rows, Mode=TwoWay}" />

                <TextBlock VerticalAlignment="Center" Text="列数" />

                <fa:FANumberBox x:CompileBindings="False"
                                MinWidth="104"
                                Minimum="1"
                                Maximum="50"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                ValidationMode="InvalidInputOverwritten"
                                Value="{Binding ViewModel.Columns, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <Grid ColumnDefinitions="* Auto" ColumnSpacing="8" Margin="8 4">
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Spacing="4" VerticalAlignment="Center">
                    <CalendarDatePicker IsTodayHighlighted="True"
                                        CustomDateFormatString="yyyy-MM-dd"
                                        SelectedDate="{Binding ViewModel.PickerDate, Mode=TwoWay}" />

                    <fa:FACommandBar DefaultLabelPosition="Right">
                        <fa:FACommandBar.PrimaryCommands>
                            <fa:FACommandBarToggleButton IsChecked="{Binding ViewModel.IsSetupMode, Mode=TwoWay}"
                                                         IconSource="{controls:FluentIconSource &#xEF26;}"
                                                         Label="设置" />

                            <fa:FACommandBarButton Click="ButtonImportSheet_OnClick"
                                                   IconSource="{controls:FluentIconSource &#xEFDD;}"
                                                   Label="导入座位表"
                                                   IsVisible="{Binding ViewModel.IsSetupMode}" />

                            <fa:FACommandBarButton Click="ButtonSave_OnClick"
                                                   IsEnabled="{Binding ViewModel.HasUnsavedChanges}"
                                                   IconSource="{controls:FluentIconSource &#xEEB5;}"
                                                   Label="保存" />
                        </fa:FACommandBar.PrimaryCommands>
                    </fa:FACommandBar>
                </StackPanel>

                <Button Grid.Column="1" Height="36"
                        VerticalAlignment="Center"
                        Theme="{StaticResource TransparentButton}">
                    <controls:IconText Glyph="{wa:Fi SlideSizeRegular}"
                                       Text="缩放" />

                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="-8 -16">
                                <Slider Width="200"
                                        Minimum="25" Maximum="300"
                                        TickFrequency="25"
                                        IsSnapToTickEnabled="True"
                                        TickPlacement="BottomRight"
                                        VerticalAlignment="Center"
                                        Value="{Binding ViewModel.ZoomPercent, Mode=TwoWay}" />

                                <TextBlock VerticalAlignment="Center"
                                           MinWidth="44" TextAlignment="Right"
                                           Text="{Binding ViewModel.ZoomPercentText}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>