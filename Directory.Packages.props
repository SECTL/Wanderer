<Project>
    <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <AvaloniaVersion>12.1.3</AvaloniaVersion>
    </PropertyGroup>
    <ItemGroup>
        <!-- Avalonia packages -->
        <!-- Important: keep version in sync! -->
        <PackageVersion Include="AsyncImageLoader.Avalonia" Version="4.0.0"/>
        <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)"/>
        <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)"/>
        <PackageVersion Include="Avalonia.Browser" Version="$(AvaloniaVersion)"/>
        <PackageVersion Include="Avalonia.Android" Version="$(AvaloniaVersion)"/>
        <!-- HotAvalonia 传递依赖 Avalonia.Markup.Xaml.Loader 11.0.0，这里显式提升到 12.1.3。 -->
        <PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)"/>
        <!-- HotAvalonia（XAML 热重载），仅在 Debug 下生效，见 Wanderer.csproj。 -->
        <PackageVersion Include="HotAvalonia" Version="3.1.5"/>
        <PackageVersion Include="HotAvalonia.Core" Version="3.1.5"/>
        <!-- Avalonia.Diagnostics was removed in Avalonia 12; Zeronia.Diagnostics provides the
             same in-process AttachDevTools() entry point for Avalonia 12. -->
        <PackageVersion Include="Zeronia.Diagnostics" Version="12.1.0"/>
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageVersion Include="ClassIsland.SimpleGitInfoGenerator" Version="1.0.0.1"/>
        <PackageVersion Include="DotNetCommon.PinYin" Version="10.0.0"/>
        <PackageVersion Include="DynamicData" Version="9.4.33"/>
        <PackageVersion Include="FluentAvaloniaUI" Version="3.1.0"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401"/>
        <PackageVersion Include="MiniExcel" Version="2.0.0-preview.4"/>
        <!-- 座位页的平移/缩放容器（ZoomBorder）。 -->
        <PackageVersion Include="PanAndZoom" Version="12.0.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3"/>
        <!-- 对齐 androidx.core:core-ktx 与 core 的版本：core 1.19 已把 AnimatorKt 等 Kotlin 扩展类
             收进 core 自身，而 core-ktx 1.17 里还有同名类，D8 会报
             "Type androidx.core.animation.AnimatorKt$addListener$1 is defined multiple times"。
             core-ktx 1.19 不再包含这些类，故显式提升到 1.19.0.1。 -->
        <PackageVersion Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1"/>
        <PackageVersion Include="Xaml.Behaviors" Version="12.0.7"/>
        <PackageVersion Include="Pastel" Version="8.0.0"/>
    </ItemGroup>
</Project>
